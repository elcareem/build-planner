# Base URL of the backend API. Copy this file to .env.local and adjust as needed.
# Local development: run the backend locally on http://localhost:4000.
# On Vercel, the value is set via apps/web/vercel.json (NEXT_PUBLIC_API_URL).
# The deployed backend URL is https://build-planner-backend.onrender.com.
NEXT_PUBLIC_API_URL=http://localhost:4000
